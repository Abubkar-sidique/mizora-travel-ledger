; Debian/Ubuntu example pool; adapt installed PHP version/service name explicitly.
[mizora]
user = mizora
group = mizora
listen = /run/php/mizora.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = dynamic
pm.max_children = 8
pm.start_servers = 2
pm.min_spare_servers = 2
pm.max_spare_servers = 4
pm.max_requests = 500
request_terminate_timeout = 65s
request_slowlog_timeout = 5s
slowlog = /var/log/mizora/fpm-slow.log
catch_workers_output = yes
clear_env = yes
security.limit_extensions = .php
env[LEDGER_ENV] = production
env[LEDGER_DB] = /var/lib/mizora/ledger.sqlite
env[LEDGER_SESSION_PATH] = /var/lib/mizora/sessions
env[LEDGER_TIMEZONE] = Asia/Karachi
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
php_admin_flag[expose_php] = off
php_admin_value[error_log] = /var/log/mizora/php-error.log
php_admin_value[memory_limit] = 128M
php_admin_value[max_execution_time] = 60
php_admin_value[post_max_size] = 64K
php_admin_value[upload_max_filesize] = 64K
php_admin_flag[file_uploads] = off
php_admin_value[cgi.fix_pathinfo] = 0
php_admin_value[session.save_path] = /var/lib/mizora/sessions
php_admin_flag[session.use_strict_mode] = on
php_admin_flag[session.use_only_cookies] = on
php_admin_flag[session.cookie_secure] = on
php_admin_flag[session.cookie_httponly] = on
php_admin_value[session.cookie_samesite] = Strict
php_admin_value[session.gc_maxlifetime] = 1800
php_admin_flag[opcache.enable] = on
; Keep timestamp checks on so a manually approved symlink switch is observed.
php_admin_flag[opcache.validate_timestamps] = on
php_admin_value[opcache.revalidate_freq] = 0
