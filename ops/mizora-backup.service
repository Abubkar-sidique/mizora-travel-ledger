[Unit]
Description=MIZORA encrypted off-server SQLite backup
OnFailure=mizora-backup-alert.service

[Service]
Type=oneshot
User=mizora
Group=mizora
UMask=0077
EnvironmentFile=/etc/mizora/backup.env
ExecStart=/bin/bash /srv/mizora/current/ops/backup-offsite.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mizora /var/backups/mizora
