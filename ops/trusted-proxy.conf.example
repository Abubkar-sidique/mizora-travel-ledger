# Optional server/http context. Do not install unchanged.
# set_real_ip_from <EXACT_PROXY_IP_OR_NARROW_CIDR>;
# real_ip_header X-Forwarded-For;
# real_ip_recursive on;
# Firewall the origin to those peers when a CDN/LB is mandatory.
# Never trust 0.0.0.0/0, ::/0, or arbitrary forwarded headers in PHP.
# This template terminates TLS at nginx even behind a CDN: use verified HTTPS to origin.
# If TLS terminates elsewhere, configure trusted scheme mapping at the server layer
# only after verifying peer restrictions; do not pass client-controlled HTTPS flags.
